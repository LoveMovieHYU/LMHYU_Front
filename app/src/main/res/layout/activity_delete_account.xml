<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete Account"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"/>

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please tell us why you're leaving"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_reasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#F5F5F5"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

        <RadioGroup
            android:id="@+id/radio_group_reasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_navy"
            android:padding="10dp">

            <RadioButton
                android:id="@+id/rb_reason1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The recommendations don't match my taste"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:layout_marginBottom="10dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

            <RadioButton
                android:id="@+id/rb_reason2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="It's hard to fine the content I want"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:layout_marginVertical="10dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

            <RadioButton
                android:id="@+id/rb_reason3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The app is inconvenient to use"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:layout_marginVertical="10dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

            <RadioButton
                android:id="@+id/rb_reason4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I'm taking a break for now"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:layout_marginVertical="10dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

            <RadioButton
                android:id="@+id/rb_reason_etc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="other"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:layout_marginTop="10dp"/>
        </RadioGroup>
    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/et_etc_reason"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_white"
        android:hint="Enter the reason"
        android:gravity="top|start"
        android:padding="16dp"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/card_reasons"/>
    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Continue"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_rounded_gray"
        android:visibility="gone"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="@null"/>

</androidx.constraintlayout.widget.ConstraintLayout>