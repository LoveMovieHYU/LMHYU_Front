<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWriteDiary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="오늘의 영화 일기 작성"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#111111"
            android:layout_marginBottom="20dp"/>

        <com.prolificinteractive.materialcalendarview.MaterialCalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_box"
            android:padding="5dp"

            app:mcv_selectionColor="#00000000"
            app:mcv_showOtherDates="all"
            app:mcv_headerTextAppearance="@android:style/TextAppearance.Medium"
            app:mcv_dateTextAppearance="@android:style/TextAppearance.Medium" />

        <LinearLayout
            android:id="@+id/layoutDiaryDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:background="@drawable/border_box"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvDetailPoster"
                android:text="Poster"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#888888"
                android:background="#EEEEEE"
                android:layout_width="80dp"
                android:layout_height="110dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="16dp"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:text="영화 제목"
                    android:textSize="18sp"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@drawable/border_box"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvDetailInfo"
                    android:text="장르 | 개봉연도"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:background="@drawable/border_box"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:text="최근 감정 요약"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/border_box"
            android:padding="10dp"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>