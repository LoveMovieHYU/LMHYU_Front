<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/surface_bright">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="정말 탈퇴하시겠어요?"
            android:textColor="@color/on_surface_light"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="탈퇴하시면 다음 정보가 모두 삭제되며\n
복구 할 수 없습니다 :\n------------------------------------------"
            android:textColor="@color/text_on_light_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• 생년월일 &amp; 닉네임\n• 바이오리듬 설정\n• 좋아요한 영화 기록"
            android:textColor="@color/text_on_light_muted"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_horizontal"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="다시 돌아가기"
                android:backgroundTint="@color/button_neutral"
                android:textColor="@color/on_surface_light"
                style="?android:attr/borderlessButtonStyle"/>

            <Button
                android:id="@+id/btn_dialog_confirm"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/surface_bright"
                android:text="정말 탈퇴하기"
                android:textColor="@color/danger_red"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
