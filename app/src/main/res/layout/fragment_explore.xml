<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/tv_explore_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginStart="20dp"
            android:text="Exploration"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_search_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_explore_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_explore_title" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33FFFFFF"
            app:layout_constraintTop_toBottomOf="@+id/tv_explore_title" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="20dp"
            android:text="Movies matched to your rhythm"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adjust Your Rhythm"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emotional"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_emotion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/Theme.MaterialComponents.DayNight"
                    style="@style/Widget.MaterialComponents.Slider"
                    android:valueFrom="-100.0"
                    android:valueTo="100.0"
                    android:value="0.0"
                    android:stepSize="1.0"
                    app:tickVisible="false"
                    app:thumbRadius="12dp"
                    app:trackHeight="6dp"
                    app:haloRadius="0dp"
                    app:thumbColor="#FF4081"
                    app:trackColorActive="#FF4081"
                    app:trackColorInactive="#E0E0E0"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intellectual"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_intellect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/Theme.MaterialComponents.DayNight"
                    style="@style/Widget.MaterialComponents.Slider"
                    android:valueFrom="-100.0"
                    android:valueTo="100.0"
                    android:value="0.0"
                    android:stepSize="1.0"
                    app:tickVisible="false"
                    app:thumbRadius="12dp"
                    app:trackHeight="6dp"
                    app:haloRadius="0dp"
                    app:thumbColor="#448AFF"
                    app:trackColorActive="#448AFF"
                    app:trackColorInactive="#E0E0E0"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physical"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_physical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:theme="@style/Theme.MaterialComponents.DayNight"
                    style="@style/Widget.MaterialComponents.Slider"
                    android:valueFrom="-100.0"
                    android:valueTo="100.0"
                    android:value="0.0"
                    android:stepSize="1.0"
                    app:tickVisible="false"
                    app:thumbRadius="12dp"
                    app:trackHeight="6dp"
                    app:haloRadius="0dp"
                    app:thumbColor="#00E676"
                    app:trackColorActive="#00E676"
                    app:trackColorInactive="#E0E0E0"
                    android:layout_marginBottom="24dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_setting_complete"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_dark_rounded"
                    android:text="Done"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_recommend_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="20dp"
            android:text="Personalized Picks"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_control" />

        <TextView
            android:id="@+id/tv_desc_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_navy"
            android:padding="16dp"
            android:text="Lower emotion and raise intellect for calm, immersive movies."
            android:textColor="#374151"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/tv_recommend_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_explore_movie_list"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:nestedScrollingEnabled="true"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc_box"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_movie_recommend" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>