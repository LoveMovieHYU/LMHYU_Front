<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".Activity.LoginActivity">

    <LinearLayout
        android:id="@+id/logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:contentDescription="Logo"
            app:srcCompat="@drawable/biorhythm_logo"
            app:tint="#DDDDDD" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_sns_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SNS 계정으로 간편 가입하기"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/button_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="342dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_in_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FFFFFF"
            android:text="Google로 로그인하기"
            android:textSize="16sp"
            android:textColor="#000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="50dp"
            app:icon="@drawable/ic_google_logo"
            app:iconSize="40dp"
            app:iconGravity="textStart"
            app:iconPadding="20dp"
            app:iconTint="@null"
            android:textAllCaps="false"
             />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_naver_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#03C75A"
            android:text="Naver로 로그인하기"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="50dp"
            app:icon="@drawable/ic_naver_logo"
            app:iconSize="40dp"
            app:iconGravity="textStart"
            app:iconPadding="20dp"
            app:iconTint="@null"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>