<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="32dp"
            android:layout_height="32dp"/>

        <TextView
            android:text="영화 일기 작성"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginLeft="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <View android:background="#EEEEEE" android:layout_width="match_parent" android:layout_height="1dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDate"
                android:text="2026년 1월 3일"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="#000000"
                android:background="@drawable/border_box"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="감정 태그 선택"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/border_box"
                android:padding="8dp"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <TextView android:id="@+id/emoji1" android:text="😊" android:textSize="30sp" android:padding="10dp" android:background="@drawable/border_box" android:layout_margin="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true"/>
                <TextView android:id="@+id/emoji2" android:text="😢" android:textSize="30sp" android:padding="10dp" android:background="@drawable/border_box" android:layout_margin="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true"/>
                <TextView android:id="@+id/emoji3" android:text="😠" android:textSize="30sp" android:padding="10dp" android:background="@drawable/border_box" android:layout_margin="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true"/>
                <TextView android:id="@+id/emoji4" android:text="😨" android:textSize="30sp" android:padding="10dp" android:background="@drawable/border_box" android:layout_margin="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true"/>
                <TextView android:id="@+id/emoji5" android:text="😴" android:textSize="30sp" android:padding="10dp" android:background="@drawable/border_box" android:layout_margin="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/border_box"
                android:padding="16dp"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Poster"
                        android:gravity="center"
                        android:background="#DDDDDD"
                        android:layout_width="80dp"
                        android:layout_height="110dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="16dp"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etTitle"
                            android:hint="영화 제목"
                            android:background="@drawable/border_box"
                            android:padding="8dp"
                            android:textSize="14sp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>
                </LinearLayout>

                <View android:background="#888888" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="15dp" android:layout_marginBottom="10dp"/>

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:numStars="5"
                    android:stepSize="1.0"
                    android:progressTint="#FFD700"
                    android:secondaryProgressTint="#00000000"/>
            </LinearLayout>

            <TextView
                android:text="영화 감상 일기"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/border_box"
                android:padding="8dp"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etContent"
                android:hint="오늘 본 영화에 대한 감상을 자유롭게 작성해주세요..."
                android:gravity="top"
                android:background="@drawable/border_box"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:minLines="6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSave"
        android:text="저장하기"
        android:backgroundTint="#111111"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>

</LinearLayout>