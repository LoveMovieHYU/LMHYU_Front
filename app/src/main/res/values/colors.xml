    <color name="text_gender">#8A8F9E</color>          <!-- 성별 라디오 텍스트 -->
    <color name="text_on_card_label">#424242</color>   <!-- 밝은 카드 위 라벨 텍스트 -->

    <!-- ===== 브랜드/액션 ===== -->
    <color name="brand_primary">#141925</color>        <!-- 주요(네이비) 버튼 -->
    <color name="brand_on_primary">#FFFFFF</color>     <!-- 주요 버튼 위 텍스트 -->
    <color name="brand_accent">#4A4A8A</color>         <!-- 캘린더 선택 등 강조 네이비 -->
