    <color name="divider_on_dark">#33FFFFFF</color>    <!-- 어두운 배경 구분선 -->
    <color name="divider_on_light">#D8D8D8</color>     <!-- 밝은 배경 구분선 -->
    <color name="neutral_divider">#E0E0E0</color>      <!-- 밝은 구분선/비활성 표면 -->
    <color name="neutral_placeholder">#333333</color>  <!-- 포스터 자리표시 배경 -->
    <color name="avatar_bg">#D1D5DC</color>            <!-- 프로필 아바타 원 배경 -->
    <color name="handle_bar">#D1D5DB</color>           <!-- 바텀시트 핸들 -->
    <color name="scrim">#99000000</color>              <!-- 딤 스크림 -->

    <!-- ===== 에러/좋아요 ===== -->
    <color name="danger_red">#FF0000</color>           <!-- 위험/삭제 텍스트 -->
    <color name="danger_red_alt">#FF3B30</color>       <!-- 계정 탈퇴 강조 -->

    <!-- ===== 바이오리듬/그래프/슬라이더 강조 (모드 공통 고정) ===== -->
    <color name="bio_physical">#FF8A8A</color>
    <color name="bio_emotional">#8AA4FF</color>
    <color name="bio_intellectual">#6FCF97</color>
    <color name="graph_physical">#F43F5E</color>
    <color name="graph_emotional">#3B82F6</color>
    <color name="graph_intellectual">#10B981</color>
    <color name="slider_physical">#FF4081</color>
    <color name="slider_emotional">#448AFF</color>
    <color name="slider_intellectual">#00E676</color>

    <!-- 내비게이션 배경 (다크 유지) -->
    <color name="nav_background">#121212</color>
</resources>
